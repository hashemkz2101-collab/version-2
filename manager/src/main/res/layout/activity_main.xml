<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:padding="20dp"
 android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="Mahroch Manager" android:textSize="26sp" android:textStyle="bold"
 android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/clientIp" android:hint="IP گوشی Client، مثال 192.168.33.200"
 android:inputType="text" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/token" android:hint="کد اتصال Client"
 android:inputType="textPassword" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/domains" android:hint="دامنه‌های مجاز، هر خط یک دامنه"
 android:minLines="8" android:gravity="top|start" android:inputType="textMultiLine"
 android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/test" android:text="تست اتصال به Client"
 android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/push" android:text="ارسال سیاست به Client"
 android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/result" android:text="آماده"
 android:textSize="16sp" android:paddingTop="16dp"
 android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>
